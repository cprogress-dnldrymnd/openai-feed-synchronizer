# Shopify Dev Dashboard app credentials.
# IMPORTANT: SHOPIFY_DOMAIN must be the *.myshopify.com domain, not the storefront
# custom domain.
SHOPIFY_DOMAIN=your-store.myshopify.com

# Used ONLY by "npm run authorize" (one-time OAuth setup) — not needed at sync time.
# client_credentials grant does not work on live/production stores, so a one-time
# authorization code grant is used instead to mint a permanent offline token.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Filled in automatically by "npm run authorize" — this is what sync.js actually uses.
# Does not expire (custom/internal apps are exempt from Shopify's token-expiry rule).
SHOPIFY_ADMIN_ACCESS_TOKEN=

# OpenAI Ads Feed SFTP connection details (from Ads Manager -> Tools -> Feeds)
SFTP_HOST=sftp.commerce.openai.com
SFTP_PORT=443
SFTP_USERNAME=
SFTP_UPLOAD_PATH=/
# Use EITHER a private key OR a password (password wins if both are set).
PRIVATE_KEY_PATH=./openai_sftp_key.pem
SFTP_PASSWORD=

# Storefront details used to build product links and seller fields
STOREFRONT_URL=https://coptrz.com
SELLER_NAME=Coptrz
TARGET_COUNTRY=GB
